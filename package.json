{
  "name": "miner-lab-simulator",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "extension:dev": "npm --prefix extension run dev",
